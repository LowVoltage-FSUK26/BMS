/*
 * WriteFrame: Generate the command frame and send it via UART.
 * The TI codes sciSend is replaced by HAL_UART_Transmit.
 */
int writeFrame(uint8_t bID, uint16_t wAddr, uint8_t * pData, uint8_t bLen, uint8_t bWriteType)
{
